#include <stdio.h>

struct alumno {
    char nombre[30];
    int edad;
    int año;
};

int main() {
    struct alumno lista[3];
    int i;
    char op;

    for (i = 0; i < 3; i++) {
        printf("\nAlumno %d\n", i + 1);
        printf("Nombre: ");
        scanf("%29s", lista[i].nombre);
        printf("Edad: ");
        scanf("%d", &lista[i].edad);
        printf("Año: ");
        scanf("%d", &lista[i].año);
    }

    for (i = 0; i < 3; i++) {
        printf("\nAlumno %d\n", i + 1);
        printf("Nombre: %s\n", lista[i].nombre);
        printf("Edad: %d\n", lista[i].edad);
        printf("Año: %d\n", lista[i].año);
    }

    for (i = 0; i < 3; i++) {
        printf("\n¿Cambiar datos del alumno %d (s-n)? ", i + 1);
        scanf(" %c", &op);

        if (op == 's') {
            printf("Nuevo nombre: ");
            scanf("%29s", lista[i].nombre);
            printf("Nueva edad: ");
            scanf("%d", &lista[i].edad);
            printf("Nuevo año: ");
            scanf("%d", &lista[i].año);
        }
    }

    for (i = 0; i < 3; i++) {
        printf("\nAlumno %d\n", i + 1);
        printf("Nombre: %s\n", lista[i].nombre);
        printf("Edad: %d\n", lista[i].edad);
        printf("Año: %d\n", lista[i].año);
    }

    return 0;
}
